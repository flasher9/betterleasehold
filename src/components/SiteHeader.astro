---
const path = Astro.url.pathname;
const links = [
  { href: '/right-to-manage/', label: 'Right to Manage' },
  { href: '/legislation/', label: 'Law tracker' },
  { href: '/about/', label: 'About' },
];
---

<header class="masthead" id="masthead">
  <div class="shell masthead__inner">
    <a class="wordmark" href="/">Better<span>Leasehold</span></a>
    <button
      class="burger"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Menu"
      hidden
    >
      <span class="burger__bar"></span>
      <span class="burger__bar"></span>
      <span class="burger__bar"></span>
    </button>
    <nav class="nav" id="site-nav" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // Header hides on scroll down / shows on scroll up; burger menu on phones.
  // Without JavaScript the nav simply stays visible as a plain list.
  const header = document.getElementById('masthead');
  const button = header?.querySelector<HTMLButtonElement>('.burger');

  if (header && button) {
    header.classList.add('masthead--enhanced');
    button.hidden = false;

    const setOpen = (open: boolean) => {
      header.classList.toggle('masthead--open', open);
      button.setAttribute('aria-expanded', String(open));
    };

    button.addEventListener('click', () => {
      setOpen(!header.classList.contains('masthead--open'));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('masthead--open')) {
        setOpen(false);
        button.focus();
      }
    });

    let lastY = window.scrollY;
    let ticking = false;

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          const goingDown = y > lastY;
          // Keep it shown near the top of the page and while the menu is open.
          const hide = goingDown && y > header.offsetHeight && !header.classList.contains('masthead--open');
          if (Math.abs(y - lastY) > 4) {
            header.classList.toggle('masthead--hidden', hide);
            lastY = y;
          }
          ticking = false;
        });
      },
      { passive: true }
    );
  }
</script>
