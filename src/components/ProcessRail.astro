---
/**
 * The statutory sequence as an arrow flow. Day counts assume the notice of
 * invitation is served on day 1 and each minimum period is used exactly;
 * `rule` is the time limit in plain terms. `kind` sets the badge style:
 * prep (no badge), start (claim notice), step, branch (disputed claim only).
 */
type Kind = 'prep' | 'start' | 'step' | 'branch';

const steps: {
  day: string | null;
  rule: string | null;
  what: string;
  href: string;
  cite: string;
  kind: Kind;
}[] = [
  {
    day: null,
    rule: null,
    what: 'Check the building qualifies',
    href: '/right-to-manage/eligibility/',
    cite: 'CLRA 2002, ss.72-75',
    kind: 'prep',
  },
  {
    day: null,
    rule: null,
    what: 'Incorporate the RTM company',
    href: '/right-to-manage/rtm-company/',
    cite: 'CLRA 2002, s.73; model articles',
    kind: 'prep',
  },
  {
    day: 'Wait at least 14 days',
    rule: null,
    what: 'Officially invite flat owners to join the company',
    href: '/right-to-manage/the-process/',
    cite: 'CLRA 2002, s.78',
    kind: 'step',
  },
  {
    day: 'Day 15',
    rule: null,
    what: 'Claim the right to manage your block',
    href: '/right-to-manage/the-process/',
    cite: 'CLRA 2002, ss.79-80',
    kind: 'start',
  },
  {
    day: 'Days 15–46',
    rule: 'up to 31 days',
    what: "Wait for the landlord's response",
    href: '/right-to-manage/the-process/',
    cite: 'CLRA 2002, s.84',
    kind: 'step',
  },
  {
    day: 'Only if disputed',
    rule: 'within 2 months, or the claim is treated as withdrawn',
    what: 'Apply to the tribunal',
    href: '/right-to-manage/the-process/',
    cite: 'CLRA 2002, s.84(3)',
    kind: 'branch',
  },
  {
    day: 'Days 46–139',
    rule: 'at least 93 days (3 months) until you take over',
    what: 'Landlord accepts: start preparing for handover',
    href: '/right-to-manage/the-process/',
    cite: 'CLRA 2002, ss.80(7), 90',
    kind: 'step',
  },
  {
    day: 'From acquisition',
    rule: 'within 14 days of a request',
    what: 'Receive service charge funds and contracts',
    href: '/right-to-manage/handover/',
    cite: 'CLRA 2002, ss.92-94',
    kind: 'step',
  },
];

// Number the main-line steps; the side path is not numbered.
let n = 0;
const numbered = steps.map((s) => ({ ...s, num: s.kind === 'branch' ? null : ++n }));

const { current = -1 } = Astro.props as { current?: number };
---

<ol class="rail">
  {
    numbered.map((s, i) => (
      <li class={`rail__step rail__step--${s.kind}`} data-current={i === current ? 'true' : undefined}>
        {s.kind === 'branch' && <span class="rail__bypass" aria-hidden="true" />}
        <span class="rail__num" aria-hidden="true">{s.num}</span>
        <span class="rail__day-cell">{s.day && <span class="rail__day">{s.day}</span>}</span>
        <span class="rail__what">
          <a href={s.href}>{s.what}</a>
          {s.rule && <span class="rail__rule">{s.rule}</span>}
          <span class="rail__cite">{s.cite}</span>
        </span>
      </li>
    ))
  }
</ol>
<div class="rail__edge">
  <strong>Not every claim follows this order.</strong>
  <p>
    There are edge cases. If the landlord does not respond at all, for example, the claim simply
    goes ahead and the acquisition date in your claim notice stands. If the landlord cannot be
    found, you apply to the tribunal instead. See <a href="/right-to-manage/the-process/">the process guide</a> for more.
  </p>
</div>
<p class="rail__note">
  Day counts assume the invitation is served on day 1 and the shortest periods allowed. The Act
  counts some periods in calendar months, so work from the exact dates in your notices.
</p>
