---
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = [
  {
    date: '3 March 2025',
    status: 'In force: ',
    what: 'Non-residential limit on RTM claims raised from 25% to 50%; costs rules changed so each side normally bears its own costs; RTM company model articles amended.',
    cite: 'Leasehold and Freehold Reform Act 2024, ss.49-52; SI 2025/131',
    url: 'https://www.legislation.gov.uk/uksi/2025/131/made',
  },
  {
    date: '27 January 2026',
    status: 'Draft: ',
    what: 'Draft Commonhold and Leasehold Reform Bill published for pre-legislative scrutiny. Commonhold as the default for new flats, a cap on existing ground rents, abolition of forfeiture.',
    cite: 'HCLG Committee reported 27 May 2026',
    url: 'https://commonslibrary.parliament.uk/research-briefings/cbp-10653/',
  },
  {
    date: '13 May 2026',
    status: 'Announced: ',
    what: 'King\u2019s Speech confirmed the Bill will be introduced in the 2026\u201327 session. The Law Commission\u2019s Right to Manage recommendations are not in this Bill and are expected to need further legislation.',
    cite: 'King\u2019s Speech 2026',
    url: 'https://commonslibrary.parliament.uk/research-briefings/cbp-10653/',
  },
];
---

<BaseLayout
  title="Law tracker"
  description="What has changed in leasehold law, what is in force, and what is still only a draft."
>
  <div class="shell hero">
    <h1>Law tracker</h1>
    <p class="hero__lede">
      Leasehold law is mid-reform and a lot of guidance online is out of date. This page records
      what is actually in force, what is announced, and what is still a draft.
    </p>
  </div>

  <div class="shell">
    <ol class="rail">
      {
        entries.map((e) => (
          <li>
            <span class="rail__clock">{e.date}</span>
            <span class="rail__what">
              <a href={e.url} rel="noopener">
                {e.status}
              </a>
              {e.what}
              <span class="rail__cite">{e.cite}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <p>
      Last checked 4 September 2026. Commencement dates move; check legislation.gov.uk before
      relying on anything here.
    </p>
  </div>
</BaseLayout>
