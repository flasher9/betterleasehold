---
/**
 * Law tracker. To change the entries, edit src/content/law-tracker.yaml;
 * how each entry looks is in src/components/LawEntry.astro.
 */
import { getCollection } from 'astro:content';
import ScrollDepth from '../components/ScrollDepth.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LawEntry from '../components/LawEntry.astro';
import { statusLabels, type LawStatus } from '../lib/law-tracker';

// Newest first, grouped by year.
const entries = (await getCollection('lawTracker'))
  .map((e) => e.data)
  .sort((a, b) => b.date.getTime() - a.date.getTime());
const years = [...new Set(entries.map((e) => e.date.getFullYear()))];

const lastChecked = '2 October 2026';

// Plain-English meanings of terms used on this page.
const jargon = [
  { term: 'Bill', meaning: 'A proposed law going through Parliament.' },
  { term: 'Act', meaning: 'A Bill that Parliament has passed. Parts of it may start later.' },
  { term: 'In force', meaning: 'Actually applies now.' },
  { term: 'Commonhold', meaning: 'Owning a flat where the owners jointly own the building, with no landlord.' },
  { term: 'Marriage value', meaning: 'An extra amount added to the price of extending a short lease.' },
];
---

<BaseLayout
  title="Law tracker"
  description="What has changed in leasehold law, what is in force, and what is still only proposed."
>
  <div class="shell hero">
    <h1>Law tracker</h1>
    <p class="hero__lede">
      Leasehold law is changing and a lot of guidance online is out of date. This page shows what
      already applies, what has been passed but is still waiting, and what is only proposed.
    </p>
    <p class="law-checked">Last checked {lastChecked}</p>
  </div>

  <div class="shell law">
    <section class="law-today" aria-labelledby="law-today-heading">
      <h2 id="law-today-heading">Right to Manage today</h2>
      <ul>
        <li><strong>Up to 50% commercial space.</strong> Mixed-use blocks can now qualify.</li>
        <li><strong>Pay your own costs.</strong> You no longer normally pay the landlord’s costs of a claim.</li>
        <li><strong>Updated company rules.</strong> RTM companies use the updated standard rules.</li>
      </ul>
      <p class="law-today__note">All in force since 3 March 2025.</p>
    </section>

    <h2>Timeline</h2>
    <div class="law-filter" role="group" aria-label="Filter by status">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      {
        (Object.keys(statusLabels) as LawStatus[]).map((s) => (
          <button type="button" data-filter={s} aria-pressed="false">
            {statusLabels[s]}
          </button>
        ))
      }
    </div>

    {
      years.map((y) => (
        <section class="law-year">
          <h2 class="law-year__label">{y}</h2>
          <ol class="law-list">
            {entries
              .filter((e) => e.date.getFullYear() === y)
              .map((e) => (
                <LawEntry entry={e} />
              ))}
          </ol>
        </section>
      ))
    }

    <section class="law-jargon" aria-labelledby="law-jargon-heading">
      <h2 id="law-jargon-heading">Jargon buster</h2>
      <dl>
        {
          jargon.map((j) => (
            <>
              <dt>{j.term}</dt>
              <dd>{j.meaning}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <p class="law-disclaimer">
      Start dates can change. Check legislation.gov.uk before relying on anything here. This page
      is general information, not legal advice.
    </p>
  </div>
  <ScrollDepth marks={[60]} />
</BaseLayout>

<script>
  // Status filter: show only entries with the chosen status, hiding years left empty.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.law-filter button'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.law-item'));
  const years = Array.from(document.querySelectorAll<HTMLElement>('.law-year'));

  const apply = (filter: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    items.forEach((i) => (i.hidden = filter !== 'all' && i.dataset.status !== filter));
    years.forEach((y) => (y.hidden = !y.querySelector('.law-item:not([hidden])')));
  };

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
</script>
